# Configuración de correo SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña
FROM_EMAIL="C&E Urban <tu-correo@gmail.com>"

# Google OAuth
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID

# Clave secreta para confirmar pagos manualmente (solo ustedes la conocen).
# Genera una propia, por ejemplo ejecutando en una terminal:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# NUNCA subas tu .env real (con la clave de verdad) a internet ni lo compartas.
ADMIN_SECRET_KEY=cambia-esto-por-una-clave-larga-y-secreta
